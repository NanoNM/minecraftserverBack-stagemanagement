# 统一换行符，避免 CRLF/LF 差异污染 diff
* text=auto

# 源码与文本文件统一使用 LF
*.java   text eol=lf
*.xml    text eol=lf
*.properties text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf

# Windows 批处理需要 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行转换
*.jar    binary
*.zip    binary
*.gz     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
